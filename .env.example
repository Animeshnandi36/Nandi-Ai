# NandiAi Environment Configuration (Render & Local Development)
# Developed by Animesh Nandi

# GROQ_API_KEY: Required for Groq LPU Ultra-Fast LLM inference (Chat, Code, Charts, Analysis)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CODE_MODEL=openai/gpt-oss-120b

# HF_API_TOKEN: Required for Hugging Face Inference API (FLUX.1-schnell Image Studio)
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Server Configuration
PORT=3000
NODE_ENV=production
