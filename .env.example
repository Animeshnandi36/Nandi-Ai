# GROQ_API_KEY: Required for Groq LPU Ultra-Fast LLM inference (Chat, Code, Charts, Analysis)
GROQ_API_KEY=MY_GROQ_API_KEY
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_CODE_MODEL=llama-3.3-70b-versatile

# HF_API_TOKEN: Required for Hugging Face Inference API (FLUX.1-schnell Image Studio & Vision)
HF_API_TOKEN=MY_HF_API_TOKEN
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell


